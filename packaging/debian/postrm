#!/bin/sh
set -e

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

if [ "$1" = remove ] && [ -L /usr/lib/mihomo-tui/current ]; then
    rm -f /usr/lib/mihomo-tui/current
    rmdir /usr/lib/mihomo-tui/cores /usr/lib/mihomo-tui 2>/dev/null || true
fi

if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload || true
fi

exit 0
